# Folders that should receive all skill folders from ./skills
# Preferred format is a JSON array. Relative paths are resolved from this .env file's folder.
# Linux/macOS examples:
SKILL_TARGET_FOLDERS=["/absolute/path/to/target-skills-folder", "./relative/target-skills-folder"]

# Windows examples:
# SKILL_TARGET_FOLDERS=["C:\\Users\\me\\.codex\\skills", "C:/Users/me/.codex/skills", "%USERPROFILE%\\.codex\\skills"]

# Subagents folders
CODEX_AGENTS_TARGET_FOLDER=["/absolute/path/to/target-codex-agents-folder", "./relative/target-codex-agents-folder"]
CLAUDE_AGENTS_TARGET_FOLDER=["/absolute/path/to/target-claude-agents-folder", "./relative/target-claude-agents-folder"]
PI_AGENTS_TARGET_FOLDER=["/absolute/path/to/target-pi-agents-folder", "./relative/target-pi-agents-folder"]
OPENCODE_AGENTS_TARGET_FOLDER=["/absolute/path/to/target-opencode-agents-folder", "./relative/target-opencode-agents-folder"]
