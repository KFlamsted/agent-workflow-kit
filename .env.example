# Folders that should receive all skill folders from ./skills
# Preferred format is a JSON array. Relative paths are resolved from this .env file's folder.
# Linux/macOS examples:
SKILL_TARGET_FOLDERS=["/absolute/path/to/target-skills-folder", "./relative/path/to/target-skills-folder"]

# Windows examples:
# SKILL_TARGET_FOLDERS=["C:\\Users\\me\\.codex\\skills", "C:/Users/me/.codex/skills", "%USERPROFILE%\\.codex\\skills"]

# Subagents folders
CODEX_AGENTS_TARGET_FOLDER=["/absolute/path/to/.codex/agents", "./relative/path/to/.codex/agents"]
CLAUDE_AGENTS_TARGET_FOLDER=["/absolute/path/to/.claude/agents", "./relative/path/to/.claude/agents"]
PI_AGENTS_TARGET_FOLDER=["/absolute/path/to/.pi/agents", "./relative/path/to/.pi/agents"]
OPENCODE_AGENTS_TARGET_FOLDER=["/absolute/path/to/.opencode/agents", "./relative/path/to/.opencode/agents"]
COPILOT_AGENTS_FOLDER=["/absolute/path/to/.copilot/agents", "./relative/path/to/.copilot/agents"]
