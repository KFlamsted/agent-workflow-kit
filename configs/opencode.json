{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build-like-pi",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "edit": "allow",
        "glob": "allow",
        "bash": "allow",
        "question": "allow"
      }
    },
    "build-like-pi": {
      "description": "Minimal Pi-inspired development agent",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "prompt": "{file:./prompts/build-like-pi.txt}",
      "temperature": 0.2,
      "permission": {
        "read": "allow",
        "grep": "allow",
        "edit": "allow",
        "glob": "allow",
        "bash": "allow",
        "question": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "permission": {
        "read": "allow",
        "grep": "allow",
        "glob": "allow",
        "edit": "deny",
        "bash": "deny",
        "question": "allow"
      }
    }
  },
  "mcp": {},
  "experimental": {
    "disable_paste_summary": true
  }
}